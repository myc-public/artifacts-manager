<?xml version="1.0" encoding="UTF-8"?>
<!--
  Canonical Maven settings.xml for the whole platform.

  Purpose: make Nexus the ONLY door in/out for dependencies and published
  artifacts. No developer machine and no Jenkins pipeline should ever
  resolve from, or deploy to, Maven Central / an external Artifactory
  directly - everything goes through Nexus, which itself proxies Central
  (see CLAUDE.md at the root of this repository).

  How this is enforced: the wildcard <mirror> below intercepts every
  repository/pluginRepository lookup (including the implicit "central" one
  every POM gets from the Super POM) and redirects it to the Nexus
  "maven-public" group repo. It does not matter what a pom.xml declares in
  <repositories> - this file wins as long as it is the active settings.xml.

  Usage:
    - Developers: copy this file to ~/.m2/settings.xml, then set
      NEXUS_USERNAME / NEXUS_PASSWORD (a Nexus user token works too) as
      environment variables.
    - Jenkins: this same content is registered as a Config File Provider
      "Managed file" (id: nexus-maven-settings) and injected via
      configFileProvider(...) in each Jenkinsfile; NEXUS_USERNAME /
      NEXUS_PASSWORD come from the "nexus-credentials" Jenkins credential.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">

    <mirrors>
        <mirror>
            <id>nexus</id>
            <mirrorOf>*</mirrorOf>
            <name>Nexus - single entry point for all repositories (blocks direct Maven Central access)</name>
            <url>${env.NEXUS_URL}/repository/maven-public/</url>
        </mirror>
    </mirrors>

    <servers>
        <!-- Read access to the maven-public group (matches the mirror id above) -->
        <server>
            <id>nexus</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
        <!-- Deploy access (matches distributionManagement ids in craft-parent / craft-platform) -->
        <server>
            <id>nexus-releases</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
        <server>
            <id>nexus-snapshots</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
    </servers>

    <!-- URLs ignored: the "*" mirror redirects them to Nexus. This profile only allows SNAPSHOT
         resolution (the Super POM's central is releases-only, and the mirror inherits that). -->
    <profiles>
        <profile>
            <id>nexus-snapshots</id>
            <repositories>
                <repository>
                    <id>central</id>
                    <url>http://localhost</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>central</id>
                    <url>http://localhost</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>nexus-snapshots</activeProfile>
    </activeProfiles>

</settings>
